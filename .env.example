# === Apify (used by the reddit and twitter providers only) ===
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Override the default actor per provider (owner/actor-name format).
# Defaults are baked in — only set these if you want to swap actors.
# Reddit defaults to the cheaper Lite actor ($3.40/1k, no monthly rental).
REDDIT_ACTOR_ID=trudax/reddit-scraper-lite
TWITTER_ACTOR_ID=apidojo/tweet-scraper
# NOTE: Medium and Substack no longer use Apify — they read free RSS feeds.
# Configure their feeds in config/scraper.config.json (medium.tags / substack.publications).

# === Hacker News & Dev.to ===
# Both use free official public APIs directly - no keys required.
# HN:     https://hacker-news.firebaseio.com/v0 (items/users) + https://hn.algolia.com/api/v1 (search, official YC/Algolia index)
# Dev.to: https://dev.to/api
DEVTO_API_KEY=

# === OpenRouter (LLM relevance filtering + enrichment) ===
# Optional but recommended. If unset, the pipeline falls back to keyword scoring.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default is DeepSeek V3.2 (cheapest capable option).
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# === Global HTTP behavior ===
DEFAULT_TIMEOUT_MS=30000
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_BASE_DELAY_MS=500

# Requests allowed per minute, per provider (simple token-bucket limiter)
RATE_LIMIT_PER_MINUTE=60

# Apify actor run polling (when not using run-sync)
APIFY_POLL_INTERVAL_MS=1500
# Match Apify's own run-sync ceiling (300s). A shorter client timeout abandons a
# run that keeps billing, so don't lower this below 300000 without good reason.
APIFY_RUN_TIMEOUT_MS=300000
# Optional hard per-run cost ceiling in USD for pay-per-event actors. 0 = off.
APIFY_MAX_TOTAL_CHARGE_USD=0

LOG_LEVEL=info

# === Slack notifications ===
# Incoming webhook URL for posting the daily report summary to a Slack channel.
# Create one at: https://api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook to Workspace
# If not set, Slack notifications are silently skipped.
SLACK_WEBHOOK_URL=

# Bot token + channel ID for uploading the full .xlsx report as a file attachment.
# Required scopes: files:write, channels:join (or be invited to the channel).
# Get the token at: https://api.slack.com/apps → your app → OAuth & Permissions → Bot Token
# Get the channel ID by right-clicking the channel in Slack → View channel details → bottom of the modal.
# If either is not set, the xlsx upload is silently skipped.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
