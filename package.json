{
  "name": "sm-scraper-bot",
  "version": "1.0.0",
  "description": "Self-contained social media scraping toolkit for Reddit, X (Twitter), Hacker News, Dev.to, Medium, and Substack.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sm-scraper": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "scrape": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
